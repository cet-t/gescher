import {
    Button,
    CheckBox,
    Slider,
    GroupBox,
    LineEdit,
} from "std-widgets.slint";

export component SettingsWindow inherits Window {
    title: "Gescher Settings";
    width: 500px;
    height: 600px;
    background: #1e1e2e;
    default-font-family: "Inter";

    // ウィンドウの×ボタンが押されたとき
    callback close-requested(); 
    
    // Slint の標準イベントを上書き
    // 注意: native ウィンドウのクローズをフックするには rust 側から .on_close_requested() を呼ぶのが一般的だが
    // UI側の「Close」ボタンなどが確実に callback を呼ぶようにする
    
    in-out property <int> buffer-size: 1024;
    in-out property <int> window-size: 10;
    in-out property <float> moving-threshold: 10.0;
    in-out property <float> angle-threshold: 22.0;
    in-out property <float> corner-threshold: 30.0;
    in-out property <bool> allow-diagonal: false;
    in-out property <bool> debug-mode: true;
    property <bool> is-dirty: false;
    property <bool> show-confirm-dialog: false;
    callback setting-changed();
    callback save-settings();
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        Text {
            text: "Gescher Configuration";
            font-size: 24px;
            font-weight: 700;
            color: #cdd6f4;
            horizontal-alignment: center;
        }

        Rectangle {
            height: 1px;
            background: #45475a;
        }

        VerticalLayout {
            spacing: 12px;
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Buffer Size (points): \{root.buffer-size}";
                    color: #bac2de;
                }

                Slider {
                    minimum: 128;
                    maximum: 2048;
                    value: root.buffer-size;
                    changed(val) => {
                        root.buffer-size = val;
                        root.is-dirty = true;
                        root.setting-changed();
                    }
                }
            }

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Window Size: \{root.window-size}";
                    color: #bac2de;
                }

                Slider {
                    minimum: 2;
                    maximum: 50;
                    value: root.window-size;
                    changed(val) => {
                        root.window-size = val;
                        root.is-dirty = true;
                        root.setting-changed();
                    }
                }
            }

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Moving Threshold: \{round(root.moving-threshold * 10) / 10}";
                    color: #bac2de;
                }

                Slider {
                    minimum: 1.0;
                    maximum: 50.0;
                    value: root.moving-threshold;
                    changed(val) => {
                        root.moving-threshold = val;
                        root.is-dirty = true;
                        root.setting-changed();
                    }
                }
            }

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Angle Threshold (deg): \{round(root.angle-threshold)}";
                    color: #bac2de;
                }

                Slider {
                    minimum: 5;
                    maximum: 90;
                    value: root.angle-threshold;
                    changed(val) => {
                        root.angle-threshold = val;
                        root.is-dirty = true;
                        root.setting-changed();
                    }
                }
            }

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Corner Threshold (deg): \{round(root.corner-threshold)}";
                    color: #bac2de;
                }

                Slider {
                    minimum: 5;
                    maximum: 90;
                    value: root.corner-threshold;
                    changed(val) => {
                        root.corner-threshold = val;
                        root.is-dirty = true;
                        root.setting-changed();
                    }
                }
            }

            HorizontalLayout {
                spacing: 20px;
                CheckBox {
                    text: "Allow Diagonal";
                    checked: root.allow-diagonal;
                    toggled => {
                        root.allow-diagonal = !root.allow-diagonal;
                        root.is-dirty = true;
                        root.setting-changed();
                    }
                }

                CheckBox {
                    text: "Debug Mode";
                    checked: root.debug-mode;
                    toggled => {
                        root.debug-mode = !root.debug-mode;
                        root.is-dirty = true;
                        root.setting-changed();
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: end;
            Button {
                text: "Minimize to Tray";
                clicked => {
                    if (root.is-dirty) {
                        root.show-confirm-dialog = true;
                    } else {
                        root.close-requested();
                    }
                }
            }

            Button {
                text: "Save to File";
                primary: true;
                enabled: root.is-dirty;
                clicked => {
                    root.save-settings();
                    root.is-dirty = false;
                }
            }
        }
    }

    if root.show-confirm-dialog: Rectangle {
        background: #000000aa;
        TouchArea { }

        Rectangle {
            width: 300px;
            height: 180px;
            background: #313244;
            border-radius: 8px;
            border-width: 1px;
            border-color: #45475a;
            VerticalLayout {
                padding: 20px;
                spacing: 20px;
                alignment: center;
                Text {
                    text: "Unsaved changes detected.";
                    color: #cdd6f4;
                    font-size: 16px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Text {
                    text: "Discard changes and minimize?";
                    color: #a6adc8;
                    font-size: 14px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;
                    Button {
                        text: "Stay";
                        clicked => {
                            root.show-confirm-dialog = false;
                        }
                    }

                    Button {
                        text: "Discard & Minimize";
                        primary: true;
                        clicked => {
                            root.show-confirm-dialog = false;
                            root.close-requested();
                        }
                    }
                }
            }
        }
    }
}
